# Copy to .env and fill in real values. Never commit .env.

# ── URLhaus (abuse.ch) — primary provider ───────────────────────────────
# Get a free key at https://auth.abuse.ch/ (self-serve, currently open).
URLHAUS_AUTH_KEY=

# ── Google Safe Browsing v4 — optional secondary signal ─────────────────
# Get a key at https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
# NOTE: Google's ToS states this API is "for non-commercial use only."
# A Telegraph Miner earns MACHINA per served request — whether that counts
# as "commercial" under Google's terms is genuinely unclear. Flagged in
# docs/url-scan-design.md; do not enable until this is resolved.
SAFE_BROWSING_API_KEY=

# ── VirusTotal — optional tertiary signal ────────────────────────────────
# Get a free key at https://www.virustotal.com/gui/join-us
# NOTE: VirusTotal's free Public API "must not be used in commercial
# products or services" per their ToS. Same caveat as above — see design doc.
VIRUSTOTAL_API_KEY=

# ── Server ────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=8000
